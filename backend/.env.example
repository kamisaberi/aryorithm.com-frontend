# Application
APP_NAME="Aryorithm Backend"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aryorithm
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.aryorithm.com"]

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
