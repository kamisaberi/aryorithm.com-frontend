# Application
APP_NAME="Aryorithm Backend"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./aryorithm.db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.aryorithm.com"]

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
