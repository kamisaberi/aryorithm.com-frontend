# Application
APP_NAME="Aryorithm Backend"
APP_ENV=development
DEBUG=true
# Use a long random key (>=32 chars) in production — short keys trigger PyJWT InsecureKeyLengthWarning
SECRET_KEY=change-me-to-a-long-random-secret-with-at-least-32-chars

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./aryorithm.db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.aryorithm.com"]

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Nexus edge-collector (X-API-Key for /fleet/sync + /threats/global-feed)
NEXUS_API_KEY=ary_dev_secret_key_8000

# Licensing — Ed25519 master keypair for signed offline .lic envelopes.
# NEVER commit the private key. Generate with:
#   PYTHONPATH=. .venv/bin/python tools/licensing/generate_keys.py
# Dev fallback reads LICENSE_KEY_FILE when the env var is empty.
ARYORITHM_MASTER_PRIVATE_KEY_B64=
ARYORITHM_MASTER_PUBLIC_KEY_B64=
LICENSE_KEY_FILE=tools/licensing/master_private.key
