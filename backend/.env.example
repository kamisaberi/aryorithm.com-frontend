# Application
APP_NAME="Aryorithm Backend"
APP_ENV=development
DEBUG=true
# Use a long random key (>=32 chars) in production — short keys trigger PyJWT InsecureKeyLengthWarning
SECRET_KEY=change-me-to-a-long-random-secret-with-at-least-32-chars

# Database: SQLite by default; MySQL 8+ on servers/cPanel.
#   SQLite: sqlite+aiosqlite:///./aryorithm.db
#   MySQL:  mysql+aiomysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4
#   (see CPANEL_MYSQL.md for MySQL install + data transfer)
# DATABASE_URL=sqlite+aiosqlite:///./aryorithm.db
DATABASE_URL=mysql+aiomysql://root@127.0.0.1:3307/aryorithm?charset=utf8mb4
# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","https://aryorithm.com","https://www.aryorithm.com","https://app.aryorithm.com","https://hub.aryorithm.com","https://backend.aryorithm.com"]

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-subdomain SSO cookies (one login for dashboard + hub + main).
# Production: COOKIE_DOMAIN=.aryorithm.com (leading dot required).
# Local dev: leave empty (localhost can't use Domain cookies).
COOKIE_DOMAIN=
COOKIE_ACCESS_NAME=ary_access
COOKIE_REFRESH_NAME=ary_refresh
COOKIE_PATH=/

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Nexus edge-collector (X-API-Key for /fleet/sync + /threats/global-feed)
NEXUS_API_KEY=ary_dev_secret_key_8000

# Licensing — Ed25519 master keypair for signed offline .lic envelopes.
# NEVER commit the private key. Generate with:
#   PYTHONPATH=. .venv/bin/python tools/licensing/generate_keys.py
# Dev fallback reads LICENSE_KEY_FILE when the env var is empty.
ARYORITHM_MASTER_PRIVATE_KEY_B64=
ARYORITHM_MASTER_PUBLIC_KEY_B64=
LICENSE_KEY_FILE=tools/licensing/master_private.key

# Aryorithm Hub (feature store) artifact vault + limits
HUB_PACKAGE_DIR=storage/packages
HUB_MAX_UPLOAD_BYTES=104857600
HUB_PUBLIC_BASE=https://hub.aryorithm.com

# Cloud Model Vault (AI model registry) artifact vault + limits.
# On-disk layout mirrors the S3 URI scheme: models/{slug}/{version}/{format}/{file}
MODEL_VAULT_DIR=storage/model-vault
MODEL_VAULT_MAX_UPLOAD_BYTES=536870912
