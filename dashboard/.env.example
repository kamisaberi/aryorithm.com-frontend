# Copy to .env.local and adjust for local development.
# Local dev default: NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Web-host build (.env.production): NEXT_PUBLIC_API_URL=https://backend.aryorithm.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Must match the backend's NEXUS_API_KEY (server env).
NEXT_PUBLIC_NEXUS_API_KEY=ary_dev_secret_key_8000
NEXT_PUBLIC_TENANT_ID=tenant-dev-local
