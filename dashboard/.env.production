# Production backend (baked into client JS at `next build` time).
# Used when you build for the web host. Local dev keeps using .env.local.
NEXT_PUBLIC_API_URL=https://backend.aryorithm.com/api/v1

# Must match the backend's NEXUS_API_KEY (server env), otherwise the
# built-in Nexus simulator / edge polling gets 401s.
NEXT_PUBLIC_NEXUS_API_KEY=ary_dev_secret_key_8000
NEXT_PUBLIC_TENANT_ID=tenant-dev-local
